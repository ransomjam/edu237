# =============================================================================
# Edu237 — Fapshi Edge Function secrets (TEMPLATE)
# =============================================================================
#
# Copy to supabase/functions/.env for LOCAL development only:
#     cp supabase/functions/.env.example supabase/functions/.env
#
# For a deployed project, set them as secrets instead — never in a file, never
# in the Flutter app, never in git:
#     supabase secrets set --env-file supabase/functions/.env
#
# The real values are issued per SERVICE on the Fapshi dashboard.
# =============================================================================

# sandbox | live. Live is never implicit: anything other than "live" is sandbox.
# Do not switch to live without an explicit decision to take real money.
FAPSHI_ENV=sandbox

# --- Collection service (money in) -------------------------------------------
FAPSHI_COLLECTION_API_USER=your-sandbox-collection-apiuser
FAPSHI_COLLECTION_API_KEY=your-sandbox-collection-apikey

# --- Payout service (money out) ----------------------------------------------
# Fapshi requires a SEPARATE service for disbursement: an activated payout
# service cannot also collect payments. Leave blank until you have one — the
# withdrawal function fails cleanly rather than pretending money moved.
FAPSHI_PAYOUT_API_USER=
FAPSHI_PAYOUT_API_KEY=

# --- Webhook -----------------------------------------------------------------
# The exact secret configured on the Fapshi dashboard. It arrives on every
# webhook request in the `x-wh-secret` header and is the only authentication
# that endpoint has.
FAPSHI_WEBHOOK_SECRET=

# --- Payment method ----------------------------------------------------------
# direct (default) — when the payer supplies a mobile money number, the prompt
#                    goes straight to their phone. Fapshi must activate Direct
#                    Pay on live before this works there.
# initiate         — always use the Fapshi-hosted checkout link instead. Needs
#                    no provider-side activation, so it is the fallback until
#                    Direct Pay is activated. The app also falls back to this
#                    automatically whenever no phone number is supplied.
FAPSHI_PAYMENT_METHOD=direct

# Optional: where Fapshi's hosted checkout returns the payer afterwards.
FAPSHI_REDIRECT_URL=
